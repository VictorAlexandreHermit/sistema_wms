# ==============================================================================
# GitIgnore - WMS Agiliza
# ==============================================================================

# Configurações com segredos reais de banco e credenciais de ambiente
config/config.php
.env
.env.*
!.env.example

# Logs do sistema (ignora arquivos .log mas preserva a pasta via .gitkeep)
logs/*
!logs/.gitkeep

# Uploads de usuários / arquivos dinamicos (ignora anexos mas preserva estrutura via .gitkeep)
uploads/avarias/*
!uploads/avarias/.gitkeep
uploads/otif/*
!uploads/otif/.gitkeep

# Dumps e backups de banco de dados (preserva scripts de migration em database/migrations/)
*.sql.gz
*.sql.bak
*.dump
backup*.sql

# Chaves privadas, Certificados e Tokens
*.pem
*.key
*.crt
*.pfx

# Arquivos temporários e caches
*.tmp
*.temp
*.log
*.swp
*.bak

# Arquivos gerados pelo Sistema Operacional
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*

# Configurações pessoais de IDEs e Editores de Código
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user
